<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup>
  <OutputType>WinExe</OutputType><TargetFramework>net8.0-windows</TargetFramework>
  <UseWindowsForms>true</UseWindowsForms><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
  <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  <AssemblyName>Scene Picker</AssemblyName>
  <RootNamespace>ScenePicker</RootNamespace>
  <ApplicationIcon>../../res/branding/gaia-launcher.ico</ApplicationIcon>
  <SelfContained>false</SelfContained>
  <GenerateDocumentationFile>false</GenerateDocumentationFile>
  <!-- the program lands in Showcase/ beside scenes.json; obj/ goes to Showcase/.build (Directory.Build.props) -->
  <OutputPath>../</OutputPath><DebugType>none</DebugType>
  <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
 </PropertyGroup>
</Project>
